{
  "expo": {
    "name": "Agenda Ministerial",
    "slug": "agenda-ministerial",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F6F2EC",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.agendaministerial.app"
    },
    "android": {
      "package": "com.agendaministerial.app",
      "adaptiveIcon": {
        "backgroundColor": "#6E1A37",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single",
      "bundler": "metro",
      "name": "Agenda Ministerial",
      "shortName": "Agenda",
      "lang": "pt-BR",
      "themeColor": "#6E1A37",
      "backgroundColor": "#F6F2EC",
      "description": "Agenda de cultos e congressos para pregadores e cantores"
    },
    "plugins": [
      "@react-native-community/datetimepicker",
      "expo-font",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Usamos sua localização para mostrar igrejas e endereços perto de você no mapa."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#6E1A37"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "fec4c4ff-6e19-49a8-9eb2-c805c91ea57a"
      }
    },
    "owner": "silasalberto",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/fec4c4ff-6e19-49a8-9eb2-c805c91ea57a",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    }
  }
}
