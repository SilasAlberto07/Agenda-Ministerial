rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Cada pessoa só lê e escreve a própria agenda
    match /users/{uid}/eventos/{eventoId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // Aparelhos (versão web/iPhone) que recebem os avisos do robô de lembretes
    match /users/{uid}/inscricoes/{inscricaoId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
